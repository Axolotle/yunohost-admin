                {
                    "name": { "en": "Change root password" },
                    "services": [],
                    "optional": true,
                    "is_action_section": false,
                    "options": [
                        {
                            "type": "alert",
                            "style": "info",
                            "icon": "info",
                            "id": "root_access_explain",
                            "name": "root_access_explain",
                            "optional": true,
                            "ask": "Sur les syst\u00e8mes Linux, 'root' est le compte administrateur absolu du syst\u00e8me\u202f: il poss\u00e8de tous les droits. Dans le contexte de YunoHost, la connexion SSH directe de 'root' est d\u00e9sactiv\u00e9e par d\u00e9faut - sauf depuis le r\u00e9seau local du serveur. Les membres du groupe 'admins' peuvent utiliser la commande sudo pour agir en tant que 'root' \u00e0 partir de la ligne de commande. Cependant, il peut \u00eatre utile de disposer d'un mot de passe root (robuste) pour d\u00e9boguer le syst\u00e8me si, pour une raison quelconque, les comptes administrateurs habituels ne peuvent plus se connecter."
                        },
                        {
                            "type": "password",
                            "optional": true,
                            "default": null,
                            "id": "root_password",
                            "name": "root_password",
                            "value": "",
                            "ask": "Nouveau mot de passe root",
                            "pattern": null
                        },
                        {
                            "type": "password",
                            "optional": true,
                            "default": null,
                            "id": "root_password_confirm",
                            "name": "root_password_confirm",
                            "value": "",
                            "ask": "Nouveau mot de passe root (confirmer)",
                            "pattern": null
                        }
                    ],
