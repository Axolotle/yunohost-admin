                    "options": [
                        {
                            "ask": "Memory footprint",
                            "type": "select",
                            "choices": {
                                "low": "Low, <= 20Mb per pool",
                                "medium": "Medium, between 20Mb and 40Mb per pool",
                                "high": "High, > 40Mb per pool",
                                "specific": "Use specific value"
                            },
                            "default": "low",
                            "id": "fpm_footprint",
                            "name": "fpm_footprint",
