        {
            "services": [],
            "actions": { "apply": { "en": "Apply" } },
            "name": { "en": "Certificate" },
            "sections": [
                {
                    "name": "",
                    "services": [],
                    "optional": true,
                    "is_action_section": true,
                    "options": [
                        {
                            "type": "alert",
                            "style": "warning",
                            "ask": "AVERTISSEMENT\u202f: Le certificat actuel est auto-sign\u00e9. Les navigateurs afficheront un avertissement alarmiste aux nouveaux visiteurs\u202f!",
                            "id": "cert_summary",
                            "name": "cert_summary",
                            "optional": true
                        },
                        {
                            "type": "number",
                            "readonly": true,
                            "visible": "false",
                            "id": "cert_validity",
                            "name": "cert_validity",
                            "optional": true,
                            "current_value": 3538,
                            "ask": "Validit\u00e9",
                            "default": null,
                            "pattern": null
                        },
                        {
                            "type": "string",
                            "visible": false,
                            "id": "cert_issuer",
                            "name": "cert_issuer",
                            "optional": true,
                            "current_value": "selfsigned",
                            "ask": "Autorit\u00e9 de certification",
                            "default": null,
                            "pattern": null
                        },
                        {
                            "type": "boolean",
                            "visible": false,
                            "id": "acme_eligible",
                            "name": "acme_eligible",
                            "optional": true,
                            "current_value": false,
                            "ask": "\u00c9ligibilit\u00e9 au protocole ACME (Automatic Certificate Management Environment, litt\u00e9ralement\u202f: environnement de gestion automatique de certificat)",
                            "default": 0,
                            "pattern": null
                        },
                        {
                            "type": "alert",
                            "style": "warning",
                            "visible": "acme_eligible == false || acme_eligible == null",
                            "id": "acme_eligible_explain",
                            "name": "acme_eligible_explain",
                            "optional": true,
                            "ask": "Ce domaine ne semble pas pr\u00eat pour installer un certificat Let's Encrypt. Veuillez v\u00e9rifier votre configuration DNS mais aussi que votre serveur est bien joignable en HTTP. Les sections 'Enregistrements DNS' et 'Web' de <a href='#/diagnosis'>la page Diagnostic</a> peuvent vous aider \u00e0 comprendre ce qui est mal configur\u00e9."
                        },
                        {
                            "type": "boolean",
                            "default": false,
                            "visible": "acme_eligible == false || acme_eligible == null",
                            "id": "cert_no_checks",
                            "name": "cert_no_checks",
                            "optional": true,
                            "current_value": false,
                            "ask": "Ignorer les tests et autres v\u00e9rifications du diagnostic",
                            "pattern": null
                        },
                        {
                            "type": "button",
                            "icon": "star",
                            "style": "success",
                            "visible": "cert_issuer != 'letsencrypt'",
                            "enabled": "acme_eligible || cert_no_checks",
                            "id": "cert_install",
                            "name": "cert_install",
                            "optional": true,
                            "ask": "Installer un certificat Let's Encrypt"
                        },
                        {
                            "type": "button",
                            "icon": "refresh",
                            "style": "warning",
                            "visible": "cert_issuer == 'letsencrypt'",
                            "enabled": "acme_eligible || cert_no_checks",
                            "id": "cert_renew",
                            "name": "cert_renew",
                            "optional": true,
                            "ask": "Renouvellement du certificat Let's Encrypt",
                            "help": "Le certificat sera automatiquement renouvel\u00e9 dans les 15 derniers jours pr\u00e9c\u00e9dant sa fin de validit\u00e9. Vous pouvez le renouveler manuellement si vous le souhaitez (non recommand\u00e9)."
                        }
                    ],
                    "id": "cert"
                }
